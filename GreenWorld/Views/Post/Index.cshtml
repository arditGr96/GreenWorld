@model IEnumerable<Post>
<div class="container">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Posts</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Post
    </a>
</div>

<div class="row g-4">
    @foreach (var post in Model.OrderByDescending(x=>x.Id))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-4 post-card overflow-hidden">
                <div class="position-relative">
                    @if (!string.IsNullOrEmpty(post.ImagePath))
                    {
                        <img src="@post.ImagePath" class="card-img-top" style="height:220px;object-fit:cover;" />
                        <div class="overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-end p-3">
                            <h5 class="text-white fw-bold mb-0">@post.Title</h5>
                        </div>
                    }
                </div>

                <div class="card-body d-flex flex-column">
                    <p class="card-text text-muted mb-4">
                        @(post.Content.Length > 120 ? post.Content.Substring(0, 120) + "..." : post.Content)
                    </p>
                    <div class="mt-auto d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-outline-warning d-flex align-items-center">
                            <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@post.Id" class="btn btn-sm btn-outline-danger d-flex align-items-center">
                            <i class="bi bi-trash me-1"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
</div>
<style>
    .post-card {
        transition: transform 0.3s, box-shadow 0.3s;
        cursor: pointer;
    }

        .post-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        }

        .post-card .overlay {
            background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.6) 100%);
        }

        .post-card .card-text {
            font-size: 0.95rem;
        }
</style>
