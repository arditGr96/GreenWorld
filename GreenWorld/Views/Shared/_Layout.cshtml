<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UNIGreen</title>

    <!-- SEO -->
    <meta name="description" content="UNIGreen – Transforming Higher Education for a Greener Tomorrow." />
    <meta name="keywords" content="UNIGreen, sustainability, Erasmus+, CBHE, green universities, Western Balkans" />
    <meta name="author" content="UNIGreen Project" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="UNIGreen Project" />
    <meta property="og:description" content="Sustainability-driven transformation for Higher Education Institutions." />
    <meta property="og:image" content="/images/unigreen-og.jpg" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Bootstrap & Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Project Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/custome/css/cssStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/custome/css/projectStructure.css" asp-append-version="true" />

</head>

<body class="w-100">

    <!-- ================= NAVBAR ================= -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-leaf me-2"></i> UNIGreen
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav ms-auto gap-lg-3">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Home/About">About</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/#structure">Work Packages</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/#consortium">Partners</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#contact">Contact</a>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>


    <!-- ================= BODY ================= -->
    <main role="main" class="min-vh-80" >
        @RenderBody()
    </main>


    <!-- ================= FOOTER ================= -->
    <footer id="contact" class="footer-section">
        <div class="container">

            <div class="footer-content">

                <!-- Column 1 -->
                <div>
                    <h5 class="fw-bold">
                        <i class="fa-solid fa-leaf me-2"></i> UNIGreen
                    </h5>
                    <p>
                        Transforming Higher Education through sustainability, innovation, and collaboration.
                    </p>

                    <div class="social-icons">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>

                <!-- Column 2 -->
                <div>
                    <h5 class="fw-bold mb-3">Navigation</h5>
                    <a href="/#about">About</a>
                    <a href="/#structure">Work Packages</a>
                    <a href="/#partners">Partners</a>
                    <a href="/#news">News</a>
                </div>

                <!-- Column 3 -->
                <div>
                    <h5 class="fw-bold mb-3">Contact Info</h5>

                    <div><i class="fa-solid fa-envelope me-2"></i> projects@unigreen.org</div>
                    <div><i class="fa-solid fa-phone me-2"></i> +383 (0) 49 123 456</div>
                    <div><i class="fa-solid fa-location-dot me-2"></i> Prishtina, Kosovo</div>
                </div>

            </div>

            <div class="text-center pt-4 mt-4 border-top border-light">
                <p class="mb-0">&copy; @DateTime.Now.Year UNIGreen. All rights reserved.</p>
            </div>

        </div>
    </footer>


    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
