@model List<Post>    
<div class="container">
        <h2 class="text-center mb-5 text-white news-header">🗞️ Latest Environmental News</h2>
        <div class="row g-4">
            @foreach(var el in Model.OrderByDescending(x=>x.Id).Skip(4))
            {
                <div class="col-lg-3 col-md-6">
                    <div class="news-card">
                        <div class="news-image-wrapper">
                            <img src="@el.ImagePath" alt="Climate Summit" class="news-image" />
                        </div>
                        <div class="news-content">
                            <h5 class="news-title">@el.Title</h5>
                            <p class="news-excerpt">
                                @el.SubTitle
                            </p>
                        <a asp-controller="Home" asp-action="PostById" asp-route-id="@el.Id" class="read-more">Read More →</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
