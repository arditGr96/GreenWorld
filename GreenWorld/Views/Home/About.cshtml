@{
    ViewData["Title"] = "About the Project";
}

<section id="about" class="content-section animate-on-scroll about-page-section">
    <div class="container">

        <h2 class="section-title">About the Project</h2>
        <div class="section-divider"></div>

        <h3 class="about-subtitle">
            A Comprehensive Approach to Sustainability in Higher Education
        </h3>

        <p class="section-text mt-4">
            UNIGreen’s mission is to support higher education institutions (HEIs) in the Western Balkans
            in aligning with the European Green Deal and the UN Sustainable Development Goals (SDGs).
            Through collaborative policy development, administrative transformation, and curriculum innovation,
            the project builds institutional capacity for sustainability-driven change.
        </p>

        <h4 class="fw-bold mt-5">Objectives</h4>

        <ul class="clean-list about-objectives mt-3">
            <li>Integrate sustainability principles into university governance and strategic management.</li>
            <li>Develop sustainable administrative models to reduce environmental impact.</li>
            <li>Modernize curricula and learning materials to embed green competences.</li>
            <li>Strengthen partnerships between academia, business, and civil society for green innovation.</li>
            <li>Promote a culture of sustainability through training, events, and awareness campaigns.</li>
        </ul>

    </div>
</section>
